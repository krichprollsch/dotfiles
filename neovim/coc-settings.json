{
  "inlayHint.enable": false,

  "diagnostic.errorSign": "✖",
  "diagnostic.warningSign": "⚠",
  "diagnostic.infoSign": "ℹ",
  "diagnostic.hintSign": "➤",
  "diagnostic.checkCurrentLine": true,
  "suggest.floatEnable": false,

  "languageserver": {
    "zls": {
      "filetypes": [ "zig", "zon" ],
      "command": "/usr/local/bin/zls"
    },
    "settings": {
      "zls.zig_exe_path": "/usr/local/bin/zig"
    }
  },

  "go.goplsArgs": ["-remote", "auto"],
  "go.goplsPath": "/home/pierre/go/bin/gopls",

  "yaml.format.enable": true,

  "zig.enabled": true,
  "zig.startUpMessage": true,
  "zig.path": "zls",
  "zig.debugLog": false,

  "[zig]": {
    "coc.preferences.formatOnSave": true,
    "semanticTokens.enable": true
  }
}
